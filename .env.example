# ─── Scanner Settings ─────────────────────────────────────────────────────────
# How often the ARP scan runs (in seconds) — default 30
HOMEGUARD_SCAN_INTERVAL=30

# How long an unknown device must be present before an alert fires (in seconds)
HOMEGUARD_UNKNOWN_THRESHOLD_SECONDS=120

# The network range to scan — match your home network (e.g. 192.168.1.0/24)
HOMEGUARD_NETWORK_CIDR=192.168.1.0/24

# Set to true to use fake devices for testing without real hardware
HOMEGUARD_DEMO_MODE=false

# ─── ThingSpeak Cloud Logging ─────────────────────────────────────────────────
# Set to true to enable sending CPU temperature and device stats to ThingSpeak
THINGSPEAK_ENABLED=true

# Your ThingSpeak channel ID — found in Channel Settings
THINGSPEAK_CHANNEL_ID=your_channel_id

# Your ThingSpeak Write API Key — found in API Keys tab
THINGSPEAK_WRITE_API_KEY=your_write_api_key

# ─── Telegram Alerts ──────────────────────────────────────────────────────────
# Set to true to enable Telegram notifications when an unknown device is detected
TELEGRAM_ENABLED=true

# Bot token provided by BotFather when you created your bot
TELEGRAM_BOT_TOKEN=your_bot_token

# Your Telegram chat ID — get it from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=your_chat_id

# ─── MQTT Publishing (HiveMQ Cloud) ───────────────────────────────────────────
# Set to true to enable publishing scan events to HiveMQ Cloud via MQTT over TLS
MQTT_ENABLED=true

# Your HiveMQ cluster URL — found in the Overview tab of your cluster
HIVEMQ_BROKER=your-cluster.s1.eu.hivemq.cloud

# HiveMQ Cloud uses port 8883 for MQTT over TLS — do not change
HIVEMQ_PORT=8883

# Credentials created in Access Management on HiveMQ Cloud
HIVEMQ_USER=your-username
HIVEMQ_PASS=your-password
